<script lang="ts">
import { defineComponent, onMounted, computed } from 'vue'
import { useRoute } from 'vue-router'
import type { Product } from '../model/types'
import axios from 'axios'

export default defineComponent({
  name: 'ProductDetail',
  props: {
    id: {
      type: [String, Number],
      required: true,
    },
  },
  data() {
    return {
      product: null as Product | null,
      loading: false,
      error: null as string | null,
    }
  },
  computed: {
    images(): string[] {
      if (!this.product) return []
      // suponiendo que product.images es un array, si tienes solo una imagen, normaliza
      return Array.isArray((this.product as any).images)
        ? (this.product as any).images
        : [(this.product as any).image ?? 'https://cdn.vuetifyjs.com/images/cards/cooking.png']
    },
  },
  async mounted() {
    this.loading = true
    try {
      // Trae el producto desde tu API por ID. Ajusta la URL según tu backend.
      const res = await axios.get(`/api/products/${this.id}`)
      this.product = res.data
    } catch (e: any) {
      this.error = e.message || 'Error cargando el producto'
    } finally {
      this.loading = false
    }
  },
})
</script>

