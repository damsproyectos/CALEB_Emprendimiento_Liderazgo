<script lang="ts">
import { PropType, defineComponent } from 'vue'
import type { Product } from '../model/types'
import { useCartStore } from '@/stores/cart'
import { useRouter } from 'vue-router'

export default defineComponent({
  name: 'ProductCard',
  props: {
    product: {
      type: Object as PropType<Product>,
      required: true,
    },
  },
  setup(props) {
    const cartStore = useCartStore()
    const router = useRouter()

    const onAddButtonClick = () => {
      cartStore.addProduct(props.product)
    }

    const goToDetail = () => {
      router.push({
        name: 'ProductDetail',
        params: { id: props.product.id },
        // si no tienes id único, puedes serializar el objeto (menos recomendable) via query o state
      })
    }

    const productImageUrl = computed(() => {
      return props.product.image ?? 'https://cdn.vuetifyjs.com/images/cards/cooking.png'
    })

    return {
      onAddButtonClick,
      goToDetail,
      productImageUrl,
    }
  },
})
</script>

<template>
  <v-card class="cursor-pointer" @click="goToDetail">
    <v-img height="250" :src="productImageUrl" cover />

    <v-card-text>
      <h3>{{ product.service }}</h3>
    </v-card-text>

    <v-card-subtitle>
      <h5>Precio Comercial: <s>{{ product.commercial_price }}</s></h5>
    </v-card-subtitle>

    <v-card-title>
